# CloudBread Chatbot 환경 변수 템플릿

# OpenAI API Key (필수)
OPENAI_API_KEY=your-openai-api-key-here

# 데이터베이스 설정 (선택 - 음식 영양 정보 조회용)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=cloudbread

# AI 서비스 URL (선택 - 다른 서비스 연동용)
PHOTO_LABEL_URL=http://photo-label-svc.ai-services.svc.cluster.local
NUTRITION_FEEDBACK_URL=http://nutrition-feedback-svc.ai-services.svc.cluster.local
FOOD_RECOMMEND_URL=http://food-recommend-svc.ai-services.svc.cluster.local
